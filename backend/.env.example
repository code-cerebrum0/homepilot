# Required
DATABASE_URL=mysql+pymysql://homepilot:change-me@localhost:3306/homepilot?charset=utf8mb4
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Frontend (CORS + cookies)
FRONTEND_ORIGIN=http://localhost:3000
# Browsers accept Secure cookies on http://localhost; set true in production (HTTPS)
COOKIE_SECURE=true
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# Day boundaries for "today", daily series and billing month
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_MAX_TOOL_ROUNDS=5

# Operations
AUTO_CREATE_TABLES=true
# Generates readings for devices created with source "simulated"
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_SECONDS=50
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
DEVICE_RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20

# ─── MCP / OAuth 2.1 ─────────────────────────────────────────────────────────

# MUST be the real public HTTPS base URL in production (issuer + MCP resource base).
# For local dev you can use http://localhost:8000 but OAuth will only work locally.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated extra origins allowed to call /mcp (in addition to FRONTEND_ORIGIN
# and PUBLIC_BASE_URL). Leave empty for no extras.
MCP_ALLOWED_ORIGINS=

# Max MCP requests per minute per access token
MCP_RATE_LIMIT_PER_MINUTE=60

# OAuth token lifetimes
OAUTH_ACCESS_TTL_SECONDS=3600
OAUTH_REFRESH_TTL_DAYS=30
OAUTH_CODE_TTL_SECONDS=300

# Dynamic Client Registration (RFC 7591) — off by default.
# Set to true to allow /oauth/register endpoint.
OAUTH_ENABLE_DCR=false

# Client ID Metadata Documents — off by default.
# When enabled client_id can be an https URL pointing to the client's metadata doc.
OAUTH_ENABLE_CIMD=false

# Comma-separated host allowlist for CIMD URLs (SSRF guard).
# Leave empty to block all private/reserved IPs.
OAUTH_CIMD_ALLOWED_HOSTS=
